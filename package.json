{
  "name": "faceoff",
  "author": "ollien",
  "version": "1.3.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10",
    "pebble-fctx": "^1.6.5"
  },
  "pebble": {
    "displayName": "Faceoff",
    "uuid": "b7990d2d-4ea8-4d2c-9b54-603ae7546fee",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "BACKGROUND_COLOR",
      "TOP_STRIPE_COLOR",
      "BOTTOM_STRIPE_COLOR",
      "FILL_CORNERS",
      "HOUR_COLOR",
      "MINUTE_COLOR",
      "TIME_FORMAT",
      "WDAY_COLOR",
      "MDAY_COLOR",
      "BW_STRIPE_STYLE",
      "TOP_COMPLICATION",
      "BOTTOM_COMPLICATION",
      "TEMPERATURE_UNIT",
      "WEATHER_REQUEST",
      "WEATHER_TEMPERATURE",
      "WEATHER_CONDITION"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "TIMEFONT",
          "file": "BebasNeue-Regular.ffont"
        },
        {
          "type": "raw",
          "name": "WEATHERFONT",
          "file": "WeatherIcons.ffont"
        },
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "menuicon.png",
          "menuIcon": true
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  },
  "devDependencies": {
    "pebble-fctx-compiler": "^1.2.2"
  }
}
