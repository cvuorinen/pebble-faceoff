{
  "name": "faceoff-remix",
  "author": "cvuorinen",
  "version": "1.0.0",
  "keywords": [
    "faceoff", "remix", "versus"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10",
    "pebble-fctx": "^1.6.5"
  },
  "pebble": {
    "displayName": "Faceoff Remix",
    "uuid": "53658c0d-1ada-4069-98df-7342270a2b50",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "BACKGROUND_COLOR",
      "TOP_STRIPE_COLOR",
      "BOTTOM_STRIPE_COLOR",
      "FILL_CORNERS",
      "HOUR_COLOR",
      "MINUTE_COLOR",
      "TIME_FORMAT",
      "WDAY_COLOR",
      "MDAY_COLOR",
      "BW_STRIPE_STYLE",
      "TOP_COMPLICATION",
      "BOTTOM_COMPLICATION",
      "TEMPERATURE_UNIT",
      "WEATHER_REQUEST",
      "WEATHER_TEMPERATURE",
      "WEATHER_CONDITION",
      "INTRO_ANIMATION",
      "TICK_ANIMATION"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "TIMEFONT",
          "file": "BebasNeue-Regular.ffont"
        },
        {
          "type": "raw",
          "name": "ICONFONT",
          "file": "Icons.ffont",
          "targetPlatforms": [
            "basalt",
            "chalk",
            "diorite",
            "emery",
            "flint",
            "gabbro"
          ]
        },
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "menuicon.png",
          "menuIcon": true
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  },
  "devDependencies": {
    "pebble-fctx-compiler": "^1.2.2"
  },
  "scripts": {
    "compile-font": "npx --no-install fctx-compiler fonts/BebasNeue-Regular.svg -r '[0-9:A-Z\u00b0.-]'",
    "compile-icon-font": "python3 scripts/build-icon-font.py"
  }
}
